# Canonical production URL of the profile (no trailing slash).
# Used for SEO metadata, sitemap, robots.txt, the vCard and — most importantly —
# the QR code printed on the business card. Must be the final public HTTPS domain.
#
# If left unset on Vercel, the project's production domain
# (VERCEL_PROJECT_PRODUCTION_URL) is used automatically.
NEXT_PUBLIC_SITE_URL=https://YOUR-FINAL-DOMAIN.vercel.app
